# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://mahalle:mahalle@localhost:5432/mahalle_dev?schema=public"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_TTL="30d"

# Cookies / sessions
SESSION_SECRET="change-me-session-secret"
# Leading-dot cookie domain so the session cookie is shared across every
# subdomain (admin., control., <tenant>.). Browsers reject a Domain=
# attribute scoped to bare "localhost", so local dev uses the
# IANA-reserved ".test" TLD instead — e.g. ".mahalle.test" — with matching
# /etc/hosts entries. See docs/dev-setup.md.
COOKIE_DOMAIN=".example.com"

# CORS - comma separated list of EXTRA allowed origins beyond COOKIE_DOMAIN's
# root (any origin under COOKIE_DOMAIN, e.g. any *.example.com, is always
# allowed automatically — this is only for origins outside that root domain).
CORS_ORIGINS="http://mahalle.test:3000"

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://api.mahalle.test:4000/api/v1"
NEXT_PUBLIC_ROOT_DOMAIN="mahalle.test:3000"
WEB_URL="http://mahalle.test:3000"
ADMIN_URL="http://admin.mahalle.test:3000"
API_URL="http://api.mahalle.test:4000"
