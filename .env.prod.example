# ---------------------------------------------------------------------------
# Mahalle SaaS — Production Environment Template
# ---------------------------------------------------------------------------
# Copy this file to .env.prod on the VPS and fill in all values.
# NEVER commit .env.prod to git.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Docker image tags (set by CI or manually when promoting)
# ---------------------------------------------------------------------------
GITHUB_OWNER=your-github-username
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# PostgreSQL (used by the postgres container AND injected into the API)
# ---------------------------------------------------------------------------
POSTGRES_USER=mahalle
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=mahalle_prod

# ---------------------------------------------------------------------------
# Redis — the compose file wires DATABASE_URL and REDIS_URL automatically
# using Docker service names, so you only need to set the postgres creds above.
# If you connect to an external database/Redis, override these:
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://mahalle:password@external-host:5432/mahalle_prod
# REDIS_URL=redis://external-host:6379

# ---------------------------------------------------------------------------
# API (NestJS) — port 4007
# ---------------------------------------------------------------------------
PORT=4007
NODE_ENV=production

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-hex-64
JWT_REFRESH_TTL=30d

# Session — generate with: openssl rand -hex 64
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-64

# Cookie domain: leading dot so the session cookie is shared across all
# subdomains (admin., control., <tenant>.)
COOKIE_DOMAIN=.eucodes.tech

# CORS origins: comma-separated extra origins beyond *.eucodes.tech
# (subdomains of COOKIE_DOMAIN are auto-allowed; only add truly external origins here)
CORS_ORIGINS=https://eucodes.tech

# ---------------------------------------------------------------------------
# Web (Next.js) — port 3007
# NEXT_PUBLIC_* vars are baked into the JS bundle at build time (they are
# injected via --build-arg in the GitHub Actions workflow, not from this file).
# They are listed here for documentation only.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://api.eucodes.tech/api/v1
# NEXT_PUBLIC_ROOT_DOMAIN=eucodes.tech
WEB_URL=https://eucodes.tech
ADMIN_URL=https://admin.eucodes.tech
API_URL=https://api.eucodes.tech
