  HAS_CONDITION
  NOT_DISCLOSED
}

enum DisabilityType {
  PHYSICAL
  VISUAL
  HEARING
  SPEECH
  INTELLECTUAL
  MULTIPLE
  OTHER
}

enum SupportStatus {
  ACTIVE
  MONITORING
  RESOLVED
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  BUSINESS
  GOVERNMENT_SERVICE
  PRIVATE_SECTOR
  DAILY_WAGE
  JOB_SEEKER
  STUDENT
  HOMEMAKER
  RETIRED
  UNABLE_TO_WORK
}

enum EducationLevel {
  NONE
  PRIMARY
  SECONDARY_SSLC
  HIGHER_SECONDARY
  DIPLOMA
  GRADUATE
  POST_GRADUATE
  DOCTORATE
  MADRASSA_ISLAMIC
