generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// A single platform-wide identity. The same User can hold a TenantMembership
/// in many tenants and, separately, a PlatformMembership on the control plane.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantMemberships       TenantMembership[]
  platformMembership      PlatformMembership?
  refreshTokens           RefreshToken[]
  auditLogsAsActor        AuditLog[]          @relation("AuditLogActor")
  onboardingDraft         OnboardingDraft?
  assignedServiceRequests ServiceRequest[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

/// One Mahalle. All tenant-owned data hangs off this via tenantId.
///
/// The location/profile/masjid/structure/management columns below are all
/// optional and are populated by the full onboarding wizard (see the
/// `onboarding` module and `OnboardingDraft`). Tenants created through the
/// older, minimal "create a Mahalle" flow simply leave them null — `country`
/// is used as the discriminator for whether a tenant went through the full
/// wizard (see the dashboard setup checklist), since Location is the one
/// step every wizard run passes through.
model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Branding
  logoUrl       String?
  coverImageUrl String?

  // Contact
  contactPhone String?
  contactEmail String?
  website      String?

  // Masjid
  masjidName    String?
  masjidPhone   String?
  masjidAddress String?
  imamName      String?
  khatheebName  String?

  // Location
  country       String?
  state         String?
  district      String?
  localBodyType String?
  localBody     String?
  place         String?
  pinCode       String?
  addressLine1  String?
  addressLine2  String?
  latitude      Float?
  longitude     Float?

  // Structure
  hasDivisions           Boolean @default(false)
  divisionTerm           String?
  houseNumberingMethod   String?
  // House-number configuration (Settings > Structure > House Configuration).
  // These only shape *new* house numbers going forward — changing them never
  // touches an existing House.displayNumber.
  houseNumberPrefix      String?
  houseNumberSuffix      String?
  houseNumberStartAt     Int?
  houseNumberMinDigits   Int?
  houseNumberAllowManual Boolean @default(true)

  // Family Status Division
  hasFamilyStatuses      Boolean @default(false)
  familyStatusTerm       String? @default("Category")

  // Management (primary committee only — the full committee is managed later)
  presidentName  String?
  presidentPhone String?
  secretaryName  String?
  secretaryPhone String?
  treasurerName  String?
  treasurerPhone String?

  memberships           TenantMembership[]
  roles                 Role[]
  auditLogs             AuditLog[]
  members               Member[]
  memberOtps            MemberOtp[]
  families              Family[]
  events                Event[]
  announcements         Announcement[]
  programs              Program[]
  divisions             TenantDivision[]
  familyStatuses        TenantFamilyStatus[]
  houses                House[]
  committeeMembers      CommitteeMember[]
  committeeMeetings     CommitteeMeeting[]
  committeeDecisions    CommitteeDecision[]
  certificateCounters   CertificateCounter[]
  deathRecords          DeathRecord[]
  marriageRecords       MarriageRecord[]
  divorceRecords        DivorceRecord[]
  mahalluReleaseRecords MahalluReleaseRecord[]
  graveRecords          GraveRecord[]
  madrassaEnrollments   MadrassaEnrollment[]
  propertyRecords       PropertyRecord[]
  financeAccounts       Account[]
  financeVouchers       Voucher[]
  financeDues           Due[]
  financeSalaryRecords  SalaryRecord[]
  serviceRequests       ServiceRequest[]
  eventRegistrations    EventRegistration[]
  notificationSettings  NotificationSettings?
  formAssignments       FormAssignment[]
  featureOverrides      TenantFeatureOverride[]
  subscription          Subscription?
  invoices              Invoice[]
  payments              Payment[]
  financeSettings       FinanceSettings?
  financePaymentMethods FinancePaymentMethod[]
  financeBankAccounts   FinanceBankAccount[]
  financialYears        FinancialYear[]
  memberHealthProfiles  MemberHealthProfile[]
  collectionCategories  CollectionCategory[]
  expenseCategories     ExpenseCategory[]
  financeCollections    FinanceCollection[]
  financeReceipts       FinanceReceipt[]
  journalEntries        JournalEntry[]
  interestFreeAccounts  InterestFreeAccount[]
  interestFreeTransactions InterestFreeTransaction[]
  taxLegalFilings       TaxLegalFiling[]

  @@index([isActive])
  @@map("tenants")
}

/// A physical dwelling within a Mahallu. Deliberately holds only a
/// system-generated id plus a free-text `displayNumber` — the human-facing
/// number/label a Mahallu actually uses, whose *format* (numeric,
/// alphanumeric, custom) is a per-tenant choice (Tenant.houseNumberingMethod)
/// never encoded into this schema. Family registration will reference a
/// House once built; for now this is structural data only.
model House {
  id            String   @id @default(cuid())
  tenantId      String
  divisionId    String?
  displayNumber String
  /// Optional human-facing label distinct from the number (e.g. "Green Villa") — the number is still the stable identifier.
  name          String?
  address       String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  division TenantDivision? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  families Family[]

  @@unique([tenantId, displayNumber])
  @@index([tenantId, isActive])
  @@index([divisionId])
  @@map("houses")
}

/// A Mahalle-defined geographical/administrative subdivision (ward, division,
/// area, zone, or a custom term — see Tenant.divisionTerm). Purely structural
/// at this stage: family/house records will reference these once family
/// registration is built, but onboarding only collects the divisions
/// themselves.
model TenantDivision {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  description String?
  order       Int      @default(0)
  /// Deactivated divisions stay on historical House/Announcement records but
  /// drop out of pickers for new ones — never hard-deleted, since houses may
  /// still reference them (onDelete: SetNull only fires on real deletion).
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  houses        House[]
  announcements Announcement[]

  @@unique([tenantId, code])
  @@index([tenantId, order])
  @@index([tenantId, isActive])
  @@map("tenant_divisions")
}

/// A Mahalle-defined family status/category division (Category A, Category B, Welfare, etc.)
model TenantFamilyStatus {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  color       String?  @default("emerald")
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  families Family[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId, order])
  @@index([tenantId, isActive])
  @@map("tenant_family_statuses")
}

/// Links a User to a Tenant with a Role. This is the row every authorization
/// check ultimately resolves through: user -> membership -> role -> permissions.
model TenantMembership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, isActive])
  @@map("tenant_memberships")
}

/// Server-side scratch state for the in-progress onboarding wizard — this is
/// what makes "resume after refresh" real rather than client-side guesswork.
/// One draft per user. `data` holds whatever the wizard has collected so far
/// for steps that don't have a real Tenant to attach to yet (location,
/// profile, structure, management); it is never itself validated against
/// CreateTenantDto — that happens once, on final submission to POST /tenants.
/// The draft becomes irrelevant the moment a Tenant exists for this user (the
/// one-Mahalle-per-account rule means there's nothing left to resume), so it
/// is deleted rather than merely marked COMPLETED.
model OnboardingDraft {
  id          String           @id @default(cuid())
  userId      String           @unique
  status      OnboardingStatus @default(DRAFT)
  currentStep String           @default("mahalle")
  data        Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_drafts")
}

enum OnboardingStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETED
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

/// Roles are scoped to a tenant so each Mahalle can eventually customize its
/// own role set. Seed data creates the standard OWNER/ADMIN/MODERATOR/EDITOR/
/// STAFF/MEMBER roles per tenant.
model Role {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String?
  /// System roles (OWNER/ADMIN/MODERATOR/EDITOR/STAFF/MEMBER) are seeded per
  /// tenant and carry the privilege-escalation rank in TENANT_ROLE_RANK —
  /// their permission sets aren't editable here. isSystem: false marks a
  /// tenant-created custom role (e.g. "Accountant"), fully editable via the
  /// Role Editor.
  isSystem    Boolean  @default(true)
  /// Soft-deactivation for custom roles — a role with active memberships
  /// can't be deactivated until every member is reassigned elsewhere (see
  /// RolesService.deactivate).
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@map("roles")
}

/// Canonical, platform-wide permission catalogue (e.g. "members.view").
/// Kept in sync with packages/types PERMISSIONS at seed time.
model Permission {
  id        String   @id @default(cuid())
  key       String   @unique
  category  String
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Platform control plane
// ---------------------------------------------------------------------------

/// Grants a User access to control.example.com. Deliberately separate from
/// TenantMembership/Role so platform authorization never shares a code path
/// with tenant authorization.
model PlatformMembership {
  id        String       @id @default(cuid())
  userId    String       @unique
  role      PlatformRole
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_memberships")
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_STAFF
  PLATFORM_SUPPORT
}

// ---------------------------------------------------------------------------
// Forms (platform capability — Section M/N/O)
// ---------------------------------------------------------------------------

/// A form as a stable, reusable concept (e.g. "Marriage NOC Request"). The
/// template itself never holds fields directly — those live on its
/// FormVersions, so a published version stays exactly as it was collected
/// even as the template evolves (Section N: never edit a historical version
/// in place).
model FormTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  category    String?
  /// When true, every active Mahalle gets this form; FormAssignment rows are
  /// only used to scope a form to specific Mahalles when this is false.
  isPlatformWide Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions    FormVersion[]
  assignments FormAssignment[]

  @@map("form_templates")
}

enum FormVersionStatus {
  DRAFT
  PUBLISHED
}

/// One immutable-once-published snapshot of a template's fields. `version`
/// is a per-template sequence (1, 2, 3, ...) shown to admins as "v1", "v2".
model FormVersion {
  id          String            @id @default(cuid())
  templateId  String
  version     Int
  status      FormVersionStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  template FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fields   FormField[]

  @@unique([templateId, version])
  @@map("form_versions")
}

enum FormFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  PHONE
  EMAIL
  DATE
  TIME
  SELECT
  MULTI_SELECT
  RADIO
  CHECKBOX
  FILE_UPLOAD
  ADDRESS
  MEMBER_LOOKUP
  FAMILY_LOOKUP
  HOUSE_LOOKUP
}

/// A single field on a form version. Only mutable while its version is
/// DRAFT — see FormsService for where that's enforced.
model FormField {
  id          String        @id @default(cuid())
  versionId   String
  key         String
  label       String
  type        FormFieldType
  description String?
  required    Boolean       @default(false)
  order       Int
  /// Option list for SELECT/MULTI_SELECT/RADIO, as string[] — never read for
  /// other field types.
  options     Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  version FormVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@index([versionId, order])
  @@map("form_fields")
}

/// Scopes a non-platform-wide FormTemplate to one specific Mahalle.
model FormAssignment {
  id         String   @id @default(cuid())
  templateId String
  tenantId   String
  createdAt  DateTime @default(now())

  template FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([templateId, tenantId])
  @@map("form_assignments")
}

// ---------------------------------------------------------------------------
// Features (platform capability — Section Q)
// ---------------------------------------------------------------------------

/// The platform-wide catalogue of toggleable modules (Finance, Marriage,
/// Madrassa, SMS, ...). `isEnabledGlobally = false` is an absolute platform
/// restriction: no TenantFeatureOverride can turn it back on for anyone
/// (Section Q — "A Mahalle must never be able to enable a feature that the
/// platform has globally disabled"). There is no Plan-entitlement layer yet
/// (Plans don't exist until Phase 7); once they do, it slots in between this
/// and the override.
model Feature {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  description       String?
  category          String?
  isEnabledGlobally Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  overrides TenantFeatureOverride[]
  planFeatures PlanFeature[]

  @@map("features")
}

/// A single Mahalle's exception to a Feature's platform default. Absence of
/// a row means "use the platform default." Only meaningful while the
/// Feature is enabled globally — see FeaturesService for where that's
/// enforced.
model TenantFeatureOverride {
  id        String   @id @default(cuid())
  tenantId  String
  featureId String
  isEnabled Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureId])
  @@map("tenant_feature_overrides")
}

// ---------------------------------------------------------------------------
// Plans & Billing (platform capability — Section R/S)
// ---------------------------------------------------------------------------

enum BillingPeriod {
  MONTHLY
  YEARLY
}

/// A sellable plan defining entitlements. Never referenced by name in
/// application logic (Section R) — features/limits live in configurable
/// rows here, not hard-coded per plan key. Sits between the platform default
/// and a Mahalle's own override in Feature's effective-enablement chain
/// (Section Q): a feature the platform allows can still be withheld from a
/// Mahalle simply because its Plan doesn't include it.
model Plan {
  id             String        @id @default(cuid())
  key            String        @unique
  name           String
  description    String?
  priceMinor     Int? // price in the smallest currency unit (e.g. paise); null = custom/contact-us pricing
  currency       String        @default("INR")
  billingPeriod  BillingPeriod @default(MONTHLY)
  userLimit      Int?
  memberLimit    Int?
  storageLimitMb Int?
  smsCredits     Int?
  supportLevel   String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

/// One Feature a Plan entitles its subscribers to. A Feature's absence here
/// means this Plan does not grant it — regardless of the platform default.
model PlanFeature {
  id        String   @id @default(cuid())
  planId    String
  featureId String
  createdAt DateTime @default(now())

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@map("plan_features")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

/// A Mahalle's billing relationship — deliberately distinct from
/// Tenant.isActive (Section S: "Mahalle: Active, Subscription: Past Due are
/// not the same thing"). One per tenant.
model Subscription {
  id                String             @id @default(cuid())
  tenantId          String             @unique
  planId            String
  status            SubscriptionStatus @default(TRIAL)
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  @@map("subscriptions")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

/// A manually-tracked bill. No payment gateway integration yet (Section AN
/// explicitly defers that to its own phase) — issuing and marking paid are
/// both platform-admin actions here, not automated charge attempts.
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  subscriptionId String?
  amountMinor    Int
  currency       String        @default("INR")
  status         InvoiceStatus @default(DRAFT)
  description    String?
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([tenantId])
  @@map("invoices")
}

/// A manually-recorded payment against an invoice (bank transfer, cash,
/// cheque, ...). Not a gateway transaction record.
model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String?
  amountMinor Int
  currency    String   @default("INR")
  method      String
  reference   String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Mahalle business data
// ---------------------------------------------------------------------------

/// A person in a Mahalle's member directory. Deliberately separate from
/// `User` — most members will never have a platform login at all; this is
/// the Mahalle's own record-keeping, not an account. Strictly tenant-owned:
/// every read/write goes through TenantContextGuard + members.* permissions,
/// and every query is scoped by tenantId (see apps/api's MembersService).
model Member {
  id        String   @id @default(cuid())
  tenantId  String
  familyId  String?
  fullName  String
  email     String?
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Personal & family-register details.
  gender         Gender?
  dateOfBirth    DateTime?
  maritalStatus  MaritalStatus?
  bloodGroup     BloodGroup?
  occupation     String?
  idNumber       String?
  relationToHead RelationToHead?

  // Movement status doubles as this member's residency history: the current
  // status plus when and why it last changed, rather than a separate
  // change-log table — a full activity timeline over AuditLog is Phase 10's
  // job, not this one's.
  movementStatus MovementStatus @default(RESIDENT)
  movementDate   DateTime?
  movementNotes  String?

  // Yatheem (orphan) register.
  isYatheem     Boolean @default(false)
  guardianName  String?
  guardianPhone String?

  // Expatriate register.
  isExpatriate         Boolean @default(false)
  expatriateCountry    String?
  expatriateOccupation String?
  expatriateContact    String?

  // Education & Employment
  educationLevel       EducationLevel?
  educationDetails     String?
  institution          String?
  employmentStatus     EmploymentStatus?
  jobTitle             String?
  employerOrBusiness   String?
  skills               String[]               @default([])
  isJobSeeker          Boolean                @default(false)
  educationHistory     Json?

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // A family being deleted shouldn't delete its members — just unlink them.
  family                Family?                @relation(fields: [familyId], references: [id], onDelete: SetNull)
  healthProfile         MemberHealthProfile?
  otps                  MemberOtp[]
  committeePosts        CommitteeMember[]
  deathRecord           DeathRecord?
  groomInMarriages      MarriageRecord[]       @relation("MarriageGroom")
  brideInMarriages      MarriageRecord[]       @relation("MarriageBride")
  husbandInDivorces     DivorceRecord[]        @relation("DivorceHusband")
  wifeInDivorces        DivorceRecord[]        @relation("DivorceWife")
  mahalluReleaseRecords MahalluReleaseRecord[]
  madrassaEnrollments   MadrassaEnrollment[]
  financeVouchers       Voucher[]
  financeDues           Due[]
  financeCollections    FinanceCollection[]
  interestFreeAccounts  InterestFreeAccount[]
  serviceRequests       ServiceRequest[]
  eventRegistrations    EventRegistration[]

  // A member logs into their own Mahalle's site with phone + OTP (see
  // MemberOtp) — the phone number is how they're found, so it must be
  // unique within the tenant. Nullable because not every directory entry
  // represents someone who will ever log in.
  @@unique([tenantId, phone])
  @@index([tenantId, isActive])
  @@index([familyId])
  @@index([tenantId, isYatheem])
  @@index([tenantId, isExpatriate])
  @@index([tenantId, bloodGroup])
  @@index([tenantId, movementStatus])
  @@index([tenantId, educationLevel])
  @@index([tenantId, employmentStatus])
  @@index([tenantId, isJobSeeker])
  @@map("members")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

/// Free-form family-role labels stay out of this enum on purpose — these are
/// the roles that matter for reports (e.g. "who is this family's head").
enum RelationToHead {
  HEAD
  SPOUSE
  SON
  DAUGHTER
  PARENT
  SIBLING
  OTHER
}

enum MovementStatus {
  RESIDENT
  MIGRATED
  MOVED_OUT
  DECEASED
}

/// A one-time password issued for a Member's phone-based login. Only the
/// hash is stored — same rationale as RefreshToken. Short-lived and
/// single-use: `consumedAt` is set the moment a code verifies successfully,
/// and a stale/expired row is simply ignored by OtpService, never revived.
model MemberOtp {
  id         String    @id @default(cuid())
  tenantId   String
  memberId   String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, consumedAt])
  @@map("member_otps")
}

/// A household unit within a Mahalle. Same tenant-isolation pattern as Member.
model Family {
  id           String   @id @default(cuid())
  tenantId     String
  houseId      String?
  /// Stable tenant-scoped identifier (e.g. "F-00125"), issued once via
  /// CertificateService's counter — never reused, never renumbered.
  /// Nullable only because rows created before this field existed have none.
  familyNumber String?
  name         String
  address      String?
  phone        String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Community Welfare & Care Support
  requiresCommunitySupport Boolean        @default(false)
  supportCategory          String?
  supportStatus            SupportStatus? @default(ACTIVE)
  supportNotes             String?
  emergencyContactName     String?
  emergencyContactPhone    String?

  // Family Status Division
  familyStatusId           String?
  category                 String?

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // A house being deleted (or a family's link cleared) shouldn't delete the family.
  // Deliberately NOT unique on houseId — a house may have more than one
  // family (see Section 4 rule: don't assume 1 house = 1 family).
  house                 House?                 @relation(fields: [houseId], references: [id], onDelete: SetNull)
  familyStatus          TenantFamilyStatus?    @relation(fields: [familyStatusId], references: [id], onDelete: SetNull)
  members               Member[]
  mahalluReleaseRecords MahalluReleaseRecord[]
  financeCollections    FinanceCollection[]
  financeDues           Due[]
  interestFreeAccounts  InterestFreeAccount[]

  @@unique([tenantId, familyNumber])
  @@index([tenantId, isActive])
  @@index([houseId])
  @@index([familyStatusId])
  @@index([tenantId, category])
  @@index([tenantId, requiresCommunitySupport])
  @@map("families")
}

/// A scheduled Mahalle event. Same tenant-isolation pattern as Member.
model Event {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  registrations   EventRegistration[]
  vouchers        Voucher[]

  @@index([tenantId, isActive])
  @@index([tenantId, startsAt])
  @@map("events")
}

/// A participant registered for an Event. `memberId` is nullable — guests
/// who aren't in the member directory can still register.
model EventRegistration {
  id               String   @id @default(cuid())
  tenantId         String
  eventId          String
  memberId         String?
  participantName  String
  participantPhone String?
  attended         Boolean  @default(false)
  createdAt        DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([tenantId, eventId])
  @@map("event_registrations")
}

/// A public notice from a Mahalle. Same tenant-isolation pattern as Member.
enum AnnouncementAudience {
  ALL
  COMMITTEE_ONLY
  DIVISION
}

model Announcement {
  id               String               @id @default(cuid())
  tenantId         String
  title            String
  body             String
  publishedAt      DateTime?
  audience         AnnouncementAudience @default(ALL)
  targetDivisionId String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetDivision TenantDivision? @relation(fields: [targetDivisionId], references: [id], onDelete: SetNull)

  @@index([tenantId, isActive])
  @@map("announcements")
}

/// An ongoing Mahalle program/initiative. Same tenant-isolation pattern as Member.
model Program {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("programs")
}

/// A person holding a committee post (President, Secretary, Treasurer, …).
/// Deliberately free-text `designation` rather than an enum — committee
/// structures vary by Mahallu (Principle 1's spirit applied to governance,
/// not just geography). Links to the existing Member directory rather than
/// duplicating a person's details here.
model CommitteeMember {
  id           String    @id @default(cuid())
  tenantId     String
  memberId     String
  designation  String
  displayOrder Int       @default(0)
  termStart    DateTime?
  termEnd      DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member           Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  meetingsAttended CommitteeMeeting[] @relation("MeetingAttendees")

  @@index([tenantId, isActive])
  @@index([memberId])
  @@map("committee_members")
}

/// A committee meeting — the official record. Minutes are the meeting's own
/// narrative summary; individually trackable action items live as
/// CommitteeDecision rows so they can be listed/searched across meetings.
model CommitteeMeeting {
  id          String                 @id @default(cuid())
  tenantId    String
  title       String
  meetingDate DateTime
  location    String?
  agenda      String?
  minutes     String?
  status      CommitteeMeetingStatus @default(SCHEDULED)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendees CommitteeMember[]   @relation("MeetingAttendees")
  decisions CommitteeDecision[]

  @@index([tenantId, meetingDate])
  @@map("committee_meetings")
}

enum CommitteeMeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// A single decision/resolution taken at a committee meeting — kept separate
/// from the meeting's free-text minutes so decisions can be listed and
/// tracked (e.g. "still pending") independent of the full narrative.
model CommitteeDecision {
  id          String   @id @default(cuid())
  tenantId    String
  meetingId   String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting CommitteeMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([meetingId])
  @@map("committee_decisions")
}

// ---------------------------------------------------------------------------
// Registers (official records — see Principle 3: Registers vs Services)
// ---------------------------------------------------------------------------

/// Per-tenant, per-register sequential counter backing certificate numbers.
/// A transaction increments this row and formats the new value — never
/// `count() + 1`, which races under concurrent issuance and can hand out the
/// same certificate number twice on an official document.
model CertificateCounter {
  id           String @id @default(cuid())
  tenantId     String
  registerType String
  lastNumber   Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, registerType])
  @@map("certificate_counters")
}

/// The Mahalle's official death register. `memberId` links back to the
/// member directory when the deceased was a registered member — nullable
/// because a Mahalle may record a death for someone never entered there.
model DeathRecord {
  id                   String    @id @default(cuid())
  tenantId             String
  memberId             String?   @unique
  deceasedName         String
  fatherOrGuardianName String?
  gender               Gender?
  dateOfBirth          DateTime?
  dateOfDeath          DateTime
  placeOfDeath         String?
  causeOfDeath         String?
  burialDate           DateTime?
  remarks              String?
  certificateNumber    String?
  certificateIssuedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  grave  GraveRecord?

  @@unique([tenantId, certificateNumber])
  @@index([tenantId, dateOfDeath])
  @@map("death_records")
}

/// The Mahalle's official marriage (nikah) register.
model MarriageRecord {
  id                  String    @id @default(cuid())
  tenantId            String
  groomName           String
  groomFatherName     String?
  groomMemberId       String?
  brideName           String
  brideFatherName     String?
  brideMemberId       String?
  marriageDate        DateTime
  place               String?
  officiantName       String?
  witness1Name        String?
  witness2Name        String?
  mahrDetails         String?
  remarks             String?
  certificateNumber   String?
  certificateIssuedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groomMember Member? @relation("MarriageGroom", fields: [groomMemberId], references: [id], onDelete: SetNull)
  brideMember Member? @relation("MarriageBride", fields: [brideMemberId], references: [id], onDelete: SetNull)

  @@unique([tenantId, certificateNumber])
  @@index([tenantId, marriageDate])
  @@map("marriage_records")
}

/// The Mahalle's official divorce register. `divorceType` is deliberately
/// free-text (Talaq/Khula/Faskh/…) rather than an enum — terminology and
/// applicable procedures vary by school of thought and jurisdiction.
model DivorceRecord {
  id                  String    @id @default(cuid())
  tenantId            String
  husbandName         String
  husbandMemberId     String?
  wifeName            String
  wifeMemberId        String?
  divorceType         String?
  divorceDate         DateTime
  place               String?
  officiantName       String?
  remarks             String?
  certificateNumber   String?
  certificateIssuedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  husbandMember Member? @relation("DivorceHusband", fields: [husbandMemberId], references: [id], onDelete: SetNull)
  wifeMember    Member? @relation("DivorceWife", fields: [wifeMemberId], references: [id], onDelete: SetNull)

  @@unique([tenantId, certificateNumber])
  @@index([tenantId, divorceDate])
  @@map("divorce_records")
}

/// A record that a member (and optionally their family) has been formally
/// released from this Mahallu's membership — typically because they've
/// relocated to another Mahallu's jurisdiction.
model MahalluReleaseRecord {
  id                  String    @id @default(cuid())
  tenantId            String
  memberId            String?
  memberName          String
  familyId            String?
  releaseDate         DateTime
  reason              String?
  destinationMahallu  String?
  remarks             String?
  certificateNumber   String?
  certificateIssuedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@unique([tenantId, certificateNumber])
  @@index([tenantId, releaseDate])
  @@map("mahallu_release_records")
}

/// The Mahalle's burial-plot register. One-to-one with a DeathRecord when
/// the burial follows a death recorded here; nullable so a plot can also be
/// logged on its own (e.g. historical burials predating this system).
model GraveRecord {
  id            String   @id @default(cuid())
  tenantId      String
  deathRecordId String?  @unique
  deceasedName  String
  plotNumber    String
  section       String?
  burialDate    DateTime
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deathRecord DeathRecord? @relation(fields: [deathRecordId], references: [id], onDelete: SetNull)

  @@unique([tenantId, plotNumber])
  @@index([tenantId])
  @@map("grave_records")
}

/// The Mahalle's madrassa/dars (religious education) enrollment register.
/// `className` is free-text since grade/level structures vary by madrassa.
model MadrassaEnrollment {
  id              String   @id @default(cuid())
  tenantId        String
  studentName     String
  studentMemberId String?
  guardianName    String?
  guardianPhone   String?
  className       String?
  admissionDate   DateTime
  isActive        Boolean  @default(true)
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentMember Member? @relation(fields: [studentMemberId], references: [id], onDelete: SetNull)

  @@index([tenantId, isActive])
  @@map("madrassa_enrollments")
}

enum PropertyType {
  WAQF
  ASSET
  RENTED
}

/// The Mahalle's property register — waqf land/buildings, other owned
/// assets, and property rented out, unified under one register with a type
/// discriminator since all three are "property the Mahallu holds a record
/// of," distinguished mainly by `propertyType` and (for rented property)
/// the lessee/rent fields.
model PropertyRecord {
  id              String       @id @default(cuid())
  tenantId        String
  propertyType    PropertyType
  name            String
  location        String?
  areaDetails     String?
  lesseeName      String?
  lesseePhone     String?
  rentAmount      String?
  acquisitionDate DateTime?
  isActive        Boolean      @default(true)
  remarks         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, propertyType, isActive])
  @@map("property_records")
}

// ---------------------------------------------------------------------------
// Finance (Principle 4: Finance owns all accounting records, including
// transactions originating from Events)
// ---------------------------------------------------------------------------
//
// This is a single-entry, cash-basis model (every Voucher is one cash
// movement categorized against an Account) rather than full double-entry
// bookkeeping. The blueprint's own open questions flagged that a proper
// chart of accounts / double-entry ledger needs accountant review before
// building it — shipping an unreviewed double-entry model here would risk
// getting the accounting itself wrong. A cash book, category totals, and a
// simple income/expense summary are all sound under single-entry and are
// what this phase implements; a formal trial balance / balance sheet in the
// double-entry sense is deferred until that review happens.

enum AccountType {
  INCOME
  EXPENSE
  ASSET
  LIABILITY
  EQUITY
}

/// A category in the Mahallu's chart of accounts. Supports hierarchical parent/child trees.
model Account {
  id              String             @id @default(cuid())
  tenantId        String
  code            String?
  name            String
  type            AccountType
  parentAccountId String?
  description     String?
  isSystem        Boolean            @default(false)
  openingBalance  Decimal            @default(0) @db.Decimal(12, 2)
  currentBalance  Decimal            @default(0) @db.Decimal(12, 2)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentAccount        Account?             @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts        Account[]            @relation("AccountHierarchy")
  vouchers             Voucher[]
  journalLines         JournalEntryLine[]
  collectionCategories CollectionCategory[]
  expenseCategories    ExpenseCategory[]
  bankAccounts         FinanceBankAccount[]

  @@unique([tenantId, name])
  @@index([tenantId, code])
  @@index([tenantId, isActive])
  @@index([parentAccountId])
  @@map("finance_accounts")
}

model FinanceSettings {
  id                             String   @id @default(cuid())
  tenantId                       String   @unique
  currency                       String   @default("INR")
  financialYearStartMonth        Int      @default(4)
  financialYearStartDay          Int      @default(1)
  defaultCollectionDescription   String?
  defaultPaymentMethodId         String?
  defaultCashAccountId           String?
  defaultBankAccountId           String?
  receiptPrefix                  String   @default("RCP")
  receiptStartNumber             Int      @default(1)
  receiptDigits                  Int      @default(6)
  voucherPrefix                  String   @default("VCH")
  voucherStartNumber             Int      @default(1)
  voucherDigits                  Int      @default(6)
  defaultSalaryExpenseAccountId  String?
  defaultCollectionIncomeAccountId String?
  defaultDonationIncomeAccountId String?
  defaultGeneralExpenseAccountId String?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("finance_settings")
}

model FinancePaymentMethod {
  id                   String   @id @default(cuid())
  tenantId             String
  name                 String
  code                 String
  type                 String   @default("CASH") // CASH, UPI, BANK_TRANSFER, CHEQUE, OTHER
  isActive             Boolean  @default(true)
  requiresReference    Boolean  @default(false)
  requiresChequeNumber Boolean  @default(false)
  requiresBankDetails  Boolean  @default(false)
  displayOrder         Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collections FinanceCollection[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("finance_payment_methods")
}

model FinanceBankAccount {
  id             String   @id @default(cuid())
  tenantId       String
  accountName    String
  bankName       String
  branch         String?
  accountNumber  String
  ifsc           String?
  accountType    String   @default("SAVINGS")
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  currentBalance Decimal  @default(0) @db.Decimal(12, 2)
  chartAccountId String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chartAccount Account?            @relation(fields: [chartAccountId], references: [id], onDelete: SetNull)
  collections  FinanceCollection[]
  vouchers     Voucher[]

  @@index([tenantId, isActive])
  @@map("finance_bank_accounts")
}

model FinancialYear {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  status    String    @default("OPEN") // OPEN, CLOSED
  isCurrent Boolean   @default(false)
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("finance_financial_years")
}

model CollectionCategory {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  code            String?
  description     String?
  incomeAccountId        String?
  targetType             String   @default("ALL_FAMILIES")
  isRecurring            Boolean  @default(false)
  isSubscription         Boolean  @default(false)
  recurrenceFrequency    String?  @default("MONTHLY")
  targetEconomicCategory String?  @default("ALL")
  targetDivisionIds      String[] @default([])
  targetAmount           Decimal? @db.Decimal(12, 2)
  defaultAmount          Decimal? @db.Decimal(12, 2)
  formConfig             Json?
  isActive               Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incomeAccount Account?            @relation(fields: [incomeAccountId], references: [id], onDelete: SetNull)
  collections   FinanceCollection[]
  dues          Due[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("finance_collection_categories")
}

model ExpenseCategory {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  code             String?
  description      String?
  expenseAccountId String?
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenseAccount Account?  @relation(fields: [expenseAccountId], references: [id], onDelete: SetNull)
  vouchers       Voucher[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("finance_expense_categories")
}

model FinanceCollection {
  id              String   @id @default(cuid())
  tenantId        String
  collectionNumber String?
  type            String   // FAMILY_COLLECTION, DAY_COLLECTION, FRIDAY_COLLECTION, DONATION, PROGRAM_COLLECTION, OTHER
  categoryId      String?
  familyId        String?
  memberId        String?
  donorName       String?
  donorPhone      String?
  donorAddress    String?
  collectorName   String?
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethodId String?
  paymentMethod   String?
  bankAccountId   String?
  date            DateTime @default(now())
  reference       String?
  description     String?
  notes           String?
  attachmentUrl   String?
  customFields    Json?
  status          String   @default("COMPLETED") // COMPLETED, CANCELLED
  receiptId       String?  @unique
  journalEntryId  String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category         CollectionCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  family           Family?               @relation(fields: [familyId], references: [id], onDelete: SetNull)
  member           Member?               @relation(fields: [memberId], references: [id], onDelete: SetNull)
  paymentMethodRef FinancePaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  bankAccount      FinanceBankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  receipt          FinanceReceipt?       @relation("CollectionReceipt", fields: [receiptId], references: [id], onDelete: SetNull)
  journalEntry     JournalEntry?         @relation("CollectionJournalEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([tenantId, collectionNumber])
  @@index([tenantId, date])
  @@index([tenantId, type])
  @@index([familyId])
  @@index([memberId])
  @@index([categoryId])
  @@map("finance_collections")
}

model FinanceReceipt {
  id              String    @id @default(cuid())
  tenantId        String
  receiptNumber   String
  voucherId       String?
  dueId           String?
  date            DateTime  @default(now())
  receivedFrom    String
  categoryName    String?
  amount          Decimal   @db.Decimal(12, 2)
  paymentMethod   String?
  reference       String?
  description     String?
  recordedBy      String?
  status          String    @default("ACTIVE") // ACTIVE, CANCELLED
  cancelledAt     DateTime?
  cancelledReason String?
  cancelledBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  collection FinanceCollection? @relation("CollectionReceipt")

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@map("finance_receipts")
}

enum VoucherType {
  RECEIPT
  PAYMENT
}

model Voucher {
  id                String              @id @default(cuid())
  tenantId          String
  voucherNumber     String?
  type              VoucherType
  voucherSubtype    String?             @default("PAYMENT") // EXPENSE, PAYMENT, GENERAL, RECEIPT
  status            String              @default("PAID") // DRAFT, SUBMITTED, APPROVED, PAID, CANCELLED
  accountId         String
  memberId          String?
  eventId           String?
  expenseCategoryId String?
  bankAccountId     String?
  date              DateTime
  amount            Decimal             @db.Decimal(12, 2)
  partyName         String?
  payeeName         String?
  paymentMethod     String?
  reference         String?
  description       String?
  attachmentUrl     String?
  notes             String?
  approvedBy        String?
  approvedAt        DateTime?
  paidAt            DateTime?
  receiptId         String?
  journalEntryId    String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account         Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  member          Member?              @relation(fields: [memberId], references: [id], onDelete: SetNull)
  event           Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  expenseCategory ExpenseCategory?     @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  bankAccount     FinanceBankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry?        @relation("VoucherJournalEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  due             Due?
  salary          SalaryRecord?

  @@unique([tenantId, voucherNumber])
  @@index([tenantId, date])
  @@index([accountId])
  @@index([eventId])
  @@index([expenseCategoryId])
  @@index([bankAccountId])
  @@map("finance_vouchers")
}

enum DueStatus {
  PENDING
  PAID
  WAIVED
}

model Due {
  id                String              @id @default(cuid())
  tenantId          String
  memberId          String
  familyId          String?
  categoryId        String?
  title             String
  period            String?
  amount            Decimal             @db.Decimal(12, 2)
  paidAmount        Decimal             @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal?            @db.Decimal(12, 2)
  dueDate           DateTime
  status            DueStatus           @default(PENDING)
  paidVoucherId     String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  family      Family?             @relation(fields: [familyId], references: [id], onDelete: SetNull)
  category    CollectionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paidVoucher Voucher?            @relation(fields: [paidVoucherId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([memberId])
  @@index([familyId])
  @@index([categoryId])
  @@map("finance_dues")
}

enum SalaryStatus {
  PENDING
  PAID
}

model SalaryRecord {
  id             String       @id @default(cuid())
  tenantId       String
  staffName      String
  month          String
  amount         Decimal      @db.Decimal(12, 2)
  basicSalary    Decimal?     @db.Decimal(12, 2)
  allowances     Decimal?     @db.Decimal(12, 2)
  deductions     Decimal?     @db.Decimal(12, 2)
  netSalary      Decimal?     @db.Decimal(12, 2)
  paymentDate    DateTime?
  paymentMethod  String?
  reference      String?
  status         SalaryStatus @default(PENDING)
  approvalStatus String       @default("PAID") // DRAFT, APPROVED, PAID, CANCELLED
  paidVoucherId  String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paidVoucher Voucher? @relation(fields: [paidVoucherId], references: [id], onDelete: SetNull)

  @@unique([tenantId, staffName, month])
  @@index([tenantId, status])
  @@map("finance_salary_records")
}

model JournalEntry {
  id             String             @id @default(cuid())
  tenantId       String
  entryNumber    String
  financialYearId String?
  date           DateTime           @default(now())
  reference      String?
  description    String
  sourceType     String             @default("MANUAL") // MANUAL, COLLECTION, DONATION, EXPENSE, SALARY, DUE, BANK_TRANSFER
  sourceId       String?
  status         String             @default("POSTED") // DRAFT, POSTED, CANCELLED
  totalDebit     Decimal            @db.Decimal(12, 2)
  totalCredit    Decimal            @db.Decimal(12, 2)
  postedAt       DateTime?
  postedBy       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  financialYear FinancialYear?     @relation(fields: [financialYearId], references: [id], onDelete: SetNull)
  lines         JournalEntryLine[]
  collection    FinanceCollection? @relation("CollectionJournalEntry")
  voucher       Voucher?           @relation("VoucherJournalEntry")

  @@unique([tenantId, entryNumber])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([financialYearId])
  @@map("finance_journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)
  description    String?
  createdAt      DateTime     @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("finance_journal_entry_lines")
}

model InterestFreeAccount {
  id            String                      @id @default(cuid())
  tenantId      String
  accountNumber String
  holderName    String
  holderType    String                      @default("MEMBER") // MEMBER, FAMILY, OTHER
  memberId      String?
  familyId      String?
  phone         String?
  balance       Decimal                     @default(0) @db.Decimal(12, 2)
  status        String                      @default("ACTIVE") // ACTIVE, DORMANT, CLOSED
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member       Member?                     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  family       Family?                     @relation(fields: [familyId], references: [id], onDelete: SetNull)
  transactions InterestFreeTransaction[]

  @@unique([tenantId, accountNumber])
  @@index([tenantId, status])
  @@map("finance_interest_free_accounts")
}

model InterestFreeTransaction {
  id            String              @id @default(cuid())
  tenantId      String
  accountId     String
  type          String              // DEPOSIT, WITHDRAWAL, TRANSFER
  amount        Decimal             @db.Decimal(12, 2)
  date          DateTime            @default(now())
  reference     String?
  description   String?
  balanceAfter  Decimal             @db.Decimal(12, 2)
  receiptNumber String?
  createdAt     DateTime            @default(now())

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account InterestFreeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([accountId])
  @@map("finance_interest_free_transactions")
}

model TaxLegalFiling {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  filingType  String    // WAKF_BOARD, TAX_RETURN, MUNICIPAL_TAX, AUDIT_REPORT, 12A_80G, OTHER
  period      String?
  dueDate     DateTime
  amount      Decimal?  @db.Decimal(12, 2)
  status      String    @default("PENDING") // PENDING, FILED, PAID, OVERDUE
  paymentDate DateTime?
  reference   String?
  notes       String?
  documentUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("finance_tax_legal_filings")
}

// ---------------------------------------------------------------------------
// Services (Principle 3: Registers = official records; Services = the
// request/workflow layer that wraps them, Events, and Certificates)
// ---------------------------------------------------------------------------

enum ServiceRequestStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

/// A member-facing (or front-desk-entered) request — never itself an
/// official record. `registerType`/`registerRecordId` optionally point at
/// the register the request concerns (e.g. "issue a copy of this death
/// certificate"); `eventId` optionally points at an Event for a
/// registration request. Approving a request never writes to a register
/// automatically — staff act on it and record the outcome here, keeping the
/// register the sole source of truth for the official record itself.
model ServiceRequest {
  id               String               @id @default(cuid())
  tenantId         String
  requestType      String
  memberId         String?
  requesterName    String
  requesterPhone   String?
  subject          String
  description      String?
  eventId          String?
  registerType     String?
  registerRecordId String?
  status           ServiceRequestStatus @default(SUBMITTED)
  assignedToUserId String?
  resolutionNotes  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member     Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  event      Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  assignedTo User?   @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("service_requests")
}

// ---------------------------------------------------------------------------
// Communication
// ---------------------------------------------------------------------------

/// Per-tenant notification preferences. SMS fields are configuration only —
/// this app has no SMS provider integration (that needs a provider choice
/// and, in India, DLT template registration, both outside this system's
/// scope to decide) — so `smsEnabled` and the provider fields describe
/// *intent*, not a working send path. No API key is stored here; wiring a
/// real provider is future work once one is chosen.
model NotificationSettings {
  id                        String   @id @default(cuid())
  tenantId                  String   @unique
  notifyOnNewServiceRequest Boolean  @default(true)
  notifyOnNewDue            Boolean  @default(true)
  eventReminderDaysBefore   Int?
  smsEnabled                Boolean  @default(false)
  smsProviderName           String?
  smsSenderId               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// A single refresh-token session. The token itself is never stored — only a
/// hash of it — so a leaked database dump doesn't hand out valid sessions.
/// Rotated on every use (`replacedById`) so a stolen-and-reused old token is
/// detectable and the whole chain can be revoked.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenChain", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenChain")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only. Nothing in the application ever updates or deletes a row here.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  tenantId    String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor  User?   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}

