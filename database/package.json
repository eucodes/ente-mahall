{
  "name": "@mahalle/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.seed.json && echo '{\"type\": \"commonjs\"}' > dist/package.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.seed.json && echo '{\"type\": \"commonjs\"}' > dist/package.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prisma": "prisma"
  },
  "dependencies": {
    "@mahalle/types": "workspace:*",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3"
  },
  "dependenciesMeta": {
    "@mahalle/types": {
      "injected": true
    }
  },
  "devDependencies": {
    "@mahalle/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
