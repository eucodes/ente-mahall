{
  "name": "mahalle-saas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "db:generate": "pnpm --filter @mahalle/database prisma generate",
    "db:migrate": "pnpm --filter @mahalle/database prisma migrate dev",
    "db:deploy": "pnpm --filter @mahalle/database prisma migrate deploy",
    "db:seed": "pnpm --filter @mahalle/database exec tsx prisma/seed.ts",
    "db:studio": "pnpm --filter @mahalle/database prisma studio",
    "seed": "pnpm db:seed",
    "migrate": "pnpm db:deploy"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "prettier": "^3.4.2"
  }
}
