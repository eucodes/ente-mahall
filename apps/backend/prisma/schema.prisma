// Ente Mahall — core data model
// Tenancy: shared database, every tenant-scoped table carries `mahallId`.
// Postgres Row-Level Security policies are applied via migration SQL (see prisma/migrations)
// so isolation is enforced at the DB layer, not only in application code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN // platform-level, Ente Mahall staff
  MAHALL_ADMIN // committee/admin for one Mahall
  STAFF // Mahall staff with limited permissions
  MEMBER // Mahall member (household head or individual)
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

enum LedgerEntryType {
  CONTRIBUTION // recurring member due / vari
  DONATION
  EXPENSE
  ADJUSTMENT
}

enum LedgerEntryStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Mahall {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  members       Member[]
  ledgerEntries LedgerEntry[]

  @@map("mahalls")
}

model User {
  id           String   @id @default(cuid())
  mahallId     String
  email        String
  passwordHash String
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mahall       Mahall        @relation(fields: [mahallId], references: [id], onDelete: Cascade)
  member       Member?
  refreshTokens RefreshToken[]

  @@unique([mahallId, email])
  @@index([mahallId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Member {
  id          String            @id @default(cuid())
  mahallId    String
  userId      String?           @unique
  fullName    String
  phone       String?
  houseNumber String?
  status      MembershipStatus  @default(PENDING)
  joinedAt    DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  mahall        Mahall        @relation(fields: [mahallId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]

  @@index([mahallId])
  @@map("members")
}

model LedgerEntry {
  id          String            @id @default(cuid())
  mahallId    String
  memberId    String?
  type        LedgerEntryType
  status      LedgerEntryStatus @default(PENDING)
  amountCents Int
  currency    String            @default("INR")
  description String?
  occurredAt  DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  mahall Mahall  @relation(fields: [mahallId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([mahallId])
  @@index([memberId])
  @@map("ledger_entries")
}
